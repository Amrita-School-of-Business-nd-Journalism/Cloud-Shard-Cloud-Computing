0.0,0.1909,12468.0,11157.5441],[55,0,54,15,165,0],"g3f9a4b66314_0_38"],[15,"g3f9a4b66314_0_39",null,0,"Research Gaps"],[17,"g3f9a4b66314_0_39",null,13,14,[],[31,0,21,"Arial",22,11.0,23,0,32,"#FFFFFF00",24,0,25,0,26,0,19,[null,1],33,0],[],1],[17,"g3f9a4b66314_0_39",null,13,14,[],[15,0.0,16,0.0,28,0.0,13,0.0,43,0,11,100.0,39,0,62,1,44,0,12,1,42,0,14,0.0],[],1],[17,"g3f9a4b66314_0_39",null,0,13,[],[0,1,50,"",1,1,5,"Nunito",56,400],[],1],[17,"g3f9a4b66314_0_39",null,13,14,[],[0,1,1,1,5,"Nunito"],[],1],[3,"g3f9a4b66314_0_40",108,[2.8169,0.0,0.0,1.3104,13866.0,40837.0001],[44,0,165,2,166,1],"g3f9a4b66314_0_38"],[15,"g3f9a4b66314_0_40",null,0,"Limited representation of complex dependencies: Existing HMM-based approaches mainly model a single hidden-state sequence, while our DBN models multiple interacting variables and dependencies.\nLimited attack progression modeling: Previous works focus mainly on detecting attacks or predicting the next state, whereas our project aims to model the complete progression of attacker states over time.\nLimited interpretability of state transitions: Existing approaches do not explicitly analyze which network features influence transitions between attacker states. Our project introduces CPT sensitivity analysis to identify the most influential features.\nLimited DBN–HMM comparison: Although both probabilistic models have been applied to intrusion detection, there is limited direct analysis of how DBN’s richer structure improves upon the HMM framework for multi-stage attack progression."],[41,"g3f9a4b66314_0_40",null,"kix.66nj6wq86r1d",[0,[25,0,36,"%0",37,"●",17,9],[],1,[25,0,36,"%1",37,"○",17,9],[],2,[25,0,36,"%2",37,"■",17,9],[],3,[25,0,36,"%3",37,"●",17,9],[],4,[25,0,36,"%4",37,"○",17,9],[],5,[25,0,36,"%5",37,"■",17,9],[],6,[25,0,36,"%6",37,"●",17,9],[],7,[25,0,36,"%7",37,"○",17,9],[],8,[25,0,36,"%8",37,"■",17,9],[]]],[41,"g3f9a4b66314_0_40",null,"kix.gsh6nr519kku",[0,[25,0,36,"%0",37,"●",17,9],[],1,[25,0,36,"%1",37,"○",17,9],[],2,[25,0,36
ver time.\nTo combine network-flow and security observations to estimate the current attacker state and predict its possible next state.\nTo perform CPT sensitivity analysis to identify which network features have the greatest influence on attacker-state transitions.\nTo evaluate and explain the model\u0027s performance by comparing the proposed DBN with HMM and conventional ML classifiers based on attack-state prediction, inference quality, and robustness to incomplete observations."],[41,"g3f9a4b66314_0_48",null,"kix.66nj6wq86r1d",[0,[36,"%0",37,"●",19,[null,1],17,9],[],1,[25,0,36,"%1",37,"○",17,9],[],2,[25,0,36,"%2",37,"■",17,9],[],3,[25,0,36,"%3",37,"●",17,9],[],4,[25,0,36,"%4",37,"○",17,9],[],5,[25,0,36,"%5",37,"■",17,9],[],6,[25,0,36,"%6",37,"●",17,9],[],7,[25,0,36,"%7",37,"○",17,9],[],8,[25,0,36,"%8",37,"■",17,9],[]]],[41,"g3f9a4b66314_0_48",null,"kix.gsh6nr519kku",[0,[25,0,36,"%0",37,"●",17,9],[],1,[25,0,36,"%1",37,"○",17,9],[],2,[25,0,36,"%2",37,"■",17,9],[],3,[25,0,36,"%3",37,"●",17,9],[],4,[25,0,36,"%4",37,"○",17,9],[],5,[25,0,36,"%5",37,"■",17,9],[],6,[25,0,36,"%6",37,"●",17,9],[],7,[25,0,36,"%7",37,"○",17,9],[],8,[25,0,36,"%8",37,"■",17,9],[]]],[17,"g3f9a4b66314_0_48",null,129,130,[],[27,"kix.66nj6wq86r1d",21,"Nunito",22,16.0,57,400,18,0],[],1],[17,"g3f9a4b66314_0_48",null,129,130,[],[16,10.0,30,0,28,18.0,13,36.0,11,115.0,39,1],[],1],[17,"g3f9a4b66314_0_48",null,255,256,[],[27,"kix.66nj6wq86r1d",21,"Nunito",22,16.0,57,400,18,0],[],1],[17,"g3f9a4b66314_0_48",null,255,256,[],[16,10.0,30,0,28,18.0,13,36.0,11,115.0,39,1],[],1],[17,"g3f9a4b66314_0_48",null,385,386,[],[27,"kix.66nj6wq86r1d",21,"Nunito",22,16.0,57,400,18,0],[],1],[17,"g3f9a4b66314_0_48",null,385,386,[],[16,10.0,30,0,28,18.0,13,36.0,11,115.0,39,1],[],1],[17,"g3f9a4b66314_0_48",null,600,601,[],[27,"kix.66nj6wq86r1d",21,"Nunito",22,16.0,57,400,18,0],[],1],[17,"g3f9a4b66314_0_48",null,600,601,[],[16,10.0,30,0,28,18.0,13,36.0,11,115.0,39,1],[],1],[17,"g3f9a4b66314_0_48",null,0,1,[],[49,[]],[],1],[1
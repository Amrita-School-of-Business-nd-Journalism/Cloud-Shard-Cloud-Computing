,"Arial",22,11.0,23,0,32,"#FFFFFF00",24,0,25,0,26,0,19,[null,1],18,0,57,400,33,0],[],1],[17,"g3f9a4b66314_0_13",null,12,13,[],[15,0.0,30,0,28,0.0,39,0,62,1,12,1,14,0.0,16,0.0,13,0.0,43,0,11,100.0,44,0,42,0],[],1],[17,"g3f9a4b66314_0_13",null,0,13,[],[0,1,50,"",1,1,5,"Nunito",56,400],[],1],[3,"g3f9a4b66314_0_14",108,[2.8169,0.0,0.0,1.2699,13866.0,40837.0001],[44,0,165,2,166,1],"g3f9a4b66314_0_12"],[15,"g3f9a4b66314_0_14",null,0,"Modern cyber attacks evolve through multiple interconnected stages, but traditional NIDS mainly identify traffic as normal or malicious, making it difficult to understand how an attack is progressing.\nTo capture this progression, probabilistic reasoning is required, since network activity is uncertain, incomplete, and dependent on events occurring over time.\nThe proposed DBN uses these temporal and probabilistic relationships to combine multiple network/security observations, infer the current attacker state, and predict how the attack may evolve beyond the capabilities of a conventional HMM.\nThe reasoning is made interpretable through CPT sensitivity analysis, identifying which network features drive state transitions, while DBN performance is compared with HMM and traditional ML approaches."],[41,"g3f9a4b66314_0_14",null,"kix.66nj6wq86r1d",[0,[25,0,57,400,36,"%0",37,"●",17,9],[],1,[25,0,57,400,36,"%1",37,"○",17,9],[],2,[25,0,57,400,36,"%2",37,"■",17,9],[],3,[25,0,57,400,36,"%3",37,"●",17,9],[],4,[25,0,57,400,36,"%4",37,"○",17,9],[],5,[25,0,57,400,36,"%5",37,"■",17,9],[],6,[25,0,57,400,36,"%6",37,"●",17,9],[],7,[25,0,57,400,36,"%7",37,"○",17,9],[],8,[25,0,57,400,36,"%8",37,"■",17,9],[]]],[41,"g3f9a4b66314_0_14",null,"kix.gsh6nr519kku",[0,[25,0,36,"%0",37,"●",17,9],[],1,[25,0,36,"%1",37,"○",17,9],[],2,[25,0,36,"%2",37,"■",17,9],[],3,[25,0,36,"%3",37,"●",17,9],[],4,[25,0,36,"%4",37,"○",17,9],[],5,[25,0,36,"%5",37,"■",17,9],[],6,[25,0,36,"%6",37,"●",17,9],[],7,[25,0,36,"%7",37,"○",17,9],[],8,[25,0,36,"%8",37,"■",17,9],[]]],[17,"g3f9a4b66314_
166,1],"g3f9a4b66314_0_100"],[15,"g3fabd9607d3_13_75",null,0,"Week 1 – DBN Construction \u0026 Learning: Finalize the DBN/2TBN architecture, define hidden attacker states and observation nodes, and learn the initial CPTs from the preprocessed time-ordered data.\nWeek 2 – Inference \u0026 Adaptation: Implement Bayesian filtering and smoothing for attacker-state estimation, next-state prediction, and adaptive CPT updating using recent observations.\nWeek 3 – Sensitivity Analysis \u0026 Evaluation: Perform CPT sensitivity analysis to rank influential features and compare the DBN against HMM and conventional ML classifiers using defined evaluation metrics.\nWeek 4 – Results \u0026 Finalization: Generate attack-progression visualizations, explainable probability/risk plots, analyze results, complete DBN–HMM comparison, and finalize the report, presentation, and project documentation."],[41,"g3fabd9607d3_13_75",null,"kix.66nj6wq86r1d",[0,[36,"%0",37,"●",19,[null,1],17,9],[],1,[36,"%1",37,"○",19,[null,1],17,9],[],2,[36,"%2",37,"■",19,[null,1],17,9],[],3,[36,"%3",37,"●",19,[null,1],17,9],[],4,[36,"%4",37,"○",19,[null,1],17,9],[],5,[36,"%5",37,"■",19,[null,1],17,9],[],6,[36,"%6",37,"●",19,[null,1],17,9],[],7,[36,"%7",37,"○",19,[null,1],17,9],[],8,[36,"%8",37,"■",19,[null,1],17,9],[]]],[17,"g3fabd9607d3_13_75",null,194,195,[],[27,"kix.66nj6wq86r1d",22,15.0,57,400,18,0],[],1],[17,"g3fabd9607d3_13_75",null,194,195,[],[16,10.0,30,0,28,18.0,13,36.0,11,115.0,39,1],[],1],[17,"g3fabd9607d3_13_75",null,377,378,[],[27,"kix.66nj6wq86r1d",22,15.0,57,400,18,0],[],1],[17,"g3fabd9607d3_13_75",null,377,378,[],[16,10.0,30,0,28,18.0,13,36.0,11,115.0,39,1],[],1],[17,"g3fabd9607d3_13_75",null,581,582,[],[27,"kix.66nj6wq86r1d",22,15.0,57,400,18,0],[],1],[17,"g3fabd9607d3_13_75",null,581,582,[],[16,10.0,30,0,28,18.0,13,36.0,11,115.0,39,1],[],1],[17,"g3fabd9607d3_13_75",null,806,807,[],[27,"kix.66nj6wq86r1d",22,15.0,57,400,18,0],[],1],[17,"g3fabd9607d3_13_75",null,806,807,[],[16,10.0,30,0,28,18.0,
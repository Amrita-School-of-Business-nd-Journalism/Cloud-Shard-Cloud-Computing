ruction: Convert network-flow features into time-slice observations and construct a 2-Time-Slice DBN with observable evidence variables and hidden attacker states.\nProbabilistic Inference \u0026 Sensitivity Analysis: Learn CPTs from training data, apply Bayesian filtering/smoothing to estimate attack progression, and perform CPT sensitivity analysis to identify influential features.\nEvaluation \u0026 Comparison: Evaluate attack-state prediction and progression against HMM and conventional ML models, while analyzing robustness, inference performance, and interpretability."],[41,"g3f9a4b66314_0_59",null,"kix.66nj6wq86r1d",[0,[57,400,36,"%0",37,"●",19,[null,1],17,9],[],1,[25,0,57,400,36,"%1",37,"○",17,9],[],2,[25,0,57,400,36,"%2",37,"■",17,9],[],3,[25,0,57,400,36,"%3",37,"●",17,9],[],4,[25,0,57,400,36,"%4",37,"○",17,9],[],5,[25,0,57,400,36,"%5",37,"■",17,9],[],6,[25,0,57,400,36,"%6",37,"●",17,9],[],7,[25,0,57,400,36,"%7",37,"○",17,9],[],8,[25,0,57,400,36,"%8",37,"■",17,9],[]]],[41,"g3f9a4b66314_0_59",null,"kix.gsh6nr519kku",[0,[25,0,57,400,36,"%0",37,"●",17,9],[],1,[25,0,57,400,36,"%1",37,"○",17,9],[],2,[25,0,57,400,36,"%2",37,"■",17,9],[],3,[25,0,57,400,36,"%3",37,"●",17,9],[],4,[25,0,57,400,36,"%4",37,"○",17,9],[],5,[25,0,57,400,36,"%5",37,"■",17,9],[],6,[25,0,57,400,36,"%6",37,"●",17,9],[],7,[25,0,57,400,36,"%7",37,"○",17,9],[],8,[25,0,57,400,36,"%8",37,"■",17,9],[]]],[17,"g3f9a4b66314_0_59",null,157,158,[],[27,"kix.66nj6wq86r1d",22,16.0,57,400,18,0],[],1],[17,"g3f9a4b66314_0_59",null,157,158,[],[16,10.0,30,0,28,18.0,13,36.0,11,115.0,39,1],[],1],[17,"g3f9a4b66314_0_59",null,344,345,[],[27,"kix.66nj6wq86r1d",22,16.0,57,400,18,0],[],1],[17,"g3f9a4b66314_0_59",null,344,345,[],[16,10.0,30,0,28,18.0,13,36.0,11,115.0,39,1],[],1],[17,"g3f9a4b66314_0_59",null,561,562,[],[27,"kix.66nj6wq86r1d",22,16.0,57,400,18,0],[],1],[17,"g3f9a4b66314_0_59",null,561,562,[],[16,10.0,30,0,28,18.0,13,36.0,11,115.0,39,1],[],1],[17,"g3f9a4b66314_0_59",null,748,749,[],[27,"kix.66nj6wq86r1d",2
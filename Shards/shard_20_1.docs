ing that all operational data remains organised and consistent. The current implementation establishes the database design and supports complete CRUD operations. Future development will extend the system by incorporating advanced database concepts such as transaction management, concurrency control and optimisation techniques to improve reliability and scalability"],[17,"g3fab3fc864c_0_117",null,673,674,[],[18,0,57,400],[],1],[17,"g3fab3fc864c_0_117",null,673,674,[],[30,0,12,4,62,1,11,150.0,16,12.0,15,12.0],[],1],[17,"g3fab3fc864c_0_117",null,0,4,[],[6,17.0,5,"Nunito",4,[null,1],56,400,50,""],[],1],[17,"g3fab3fc864c_0_117",null,4,36,[],[6,17.0,0,1,5,"Nunito",4,"#9F0F0C",56,400,50,""],[],1],[17,"g3fab3fc864c_0_117",null,36,673,[],[6,17.0,5,"Nunito",4,[null,1],56,400,50,""],[],1],[17,"g3fab3fc864c_0_117",null,673,674,[],[6,24.0,5,"Nunito",56,400],[],1],[3,"g3fab3fc864c_0_118",158,[2.032,0.0,0.0,1.143,15252.0,27432.0],[55,0,54,16],"g3fab3fc864c_0_113:notes"],[3,"g3fab3fc864c_0_119",108,[1.8288,0.0,0.0,1.3716,27432.0,173736.0],[55,1,54,1],"g3fab3fc864c_0_113:notes"],[17,"g3fab3fc864c_0_119",null,0,1,[],[13,0.0,28,0.0],[],1]],"revision":4389}; var modelChunkParseEnd = new Date().getTime(); var parseTime = modelChunkParseEnd - DOCS_modelChunkParseStart; window['DOCS_appBootstrapReadyPromise'].then(function() {DOCS_initialLoadTiming.incrementTime('mp', parseTime); DOCS_warmStartDocumentLoader.loadModelChunk(modelChunk);});})();</script><script nonce="osq4uqrEjaZ_QiuRZICv1w">var DOCS_modelChunkParseStart = new Date().getTime();</script><script nonce="osq4uqrEjaZ_QiuRZICv1w">(function() {var modelChunk = {"chunk":[[12,"g3fab3fc864c_0_238",4,0,[1,"simple-light-2",2,"TITLE_AND_BODY",9,1]],[3,"g3fab3fc864c_0_239",108,[2.8402,0.0,0.0,0.1909,12468.0,3831.0011],[55,0,163,0.9,164,0.0,54,15],"g3fab3fc864c_0_238"],[15,"g3fab3fc864c_0_239",null,0,"Objectives:"],[17,"g3fab3fc864c_0_239",null,0,11,[],[0,1,5,"Nunito",1,1],[],1],[17,"g3fab3fc864c_0_239",null,11,12,[],[0,1,1,1],[],1],[3,"g
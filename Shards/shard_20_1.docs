ll,4],44,0,60,0,165,2,166,1],"g3fab3fc864c_0_60"],[15,"g3fab3fc864c_0_65",null,0,"Traditional delivery systems are often constrained by traffic congestion, delivery delays and high operational costs.\nManaging drones, batteries, packages, routes, maintenance records and payments independently leads to fragmented information and inefficient operations.\nThe absence of a centralised database increases the risk of data redundancy, inconsistencies and poor resource utilisation.\nMonitoring delivery status, drone availability and battery health in real time becomes increasingly difficult as the delivery network grows."],[41,"g3fab3fc864c_0_65",null,"kix.mw1yxv5vb857",[0,[22,18.0,19,[null,3]],[],1,[19,[null,3]],[],2,[19,[null,3]],[],3,[19,[null,3]],[],4,[19,[null,3]],[],5,[19,[null,3]],[],6,[19,[null,3]],[],7,[19,[null,3]],[],8,[19,[null,3]],[]]],[41,"g3fab3fc864c_0_65",null,"kix.oy5q7d1q1xf7",[0,[22,18.0,19,[null,3]],[],1,[19,[null,3]],[],2,[19,[null,3]],[],3,[19,[null,3]],[],4,[19,[null,3]],[],5,[19,[null,3]],[],6,[19,[null,3]],[],7,[19,[null,3]],[],8,[19,[null,3]],[]]],[17,"g3fab3fc864c_0_65",null,117,118,[],[18,0,19,[null,1],57,400,27,"kix.oy5q7d1q1xf7",21,"Nunito",22,15.0],[],1],[17,"g3fab3fc864c_0_65",null,117,118,[],[30,0,13,36.0,39,1,28,18.0,11,150.0],[],1],[17,"g3fab3fc864c_0_65",null,270,271,[],[18,0,19,[null,1],57,400,27,"kix.oy5q7d1q1xf7",21,"Nunito",22,15.0],[],1],[17,"g3fab3fc864c_0_65",null,270,271,[],[30,0,13,36.0,39,1,28,18.0,11,150.0],[],1],[17,"g3fab3fc864c_0_65",null,394,395,[],[18,0,19,[null,1],57,400,27,"kix.oy5q7d1q1xf7",21,"Nunito",22,15.0],[],1],[17,"g3fab3fc864c_0_65",null,394,395,[],[30,0,13,36.0,39,1,28,18.0,11,150.0],[],1],[17,"g3fab3fc864c_0_65",null,535,536,[],[18,0,19,[null,1],57,400,27,"kix.oy5q7d1q1xf7",21,"Nunito",22,15.0],[],1],[17,"g3fab3fc864c_0_65",null,535,536,[],[30,0,13,36.0,39,1,28,18.0,11,150.0],[],1],[17,"g3fab3fc864c_0_65",null,0,54,[],[6,11.0,5,"Nunito",4,[null,1],56,400,50,""],[],1],[17,"g3fab3fc864c_0_65",null,54,116,[],[6,